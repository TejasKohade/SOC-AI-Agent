# Copy to .env and fill in. LLM_PROVIDER: bedrock | openrouter | offline
LLM_PROVIDER=bedrock
# Amazon Bedrock (Claude). Bedrock API key = bearer token; short-term keys expire after 12 h
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=ap-southeast-2
BEDROCK_MODEL=au.anthropic.claude-haiku-4-5-20251001-v1:0   # cheap + reliable for security; apac.amazon.nova-pro-v1:0 cheaper still (but Amazon content filter blocks some prompts); au.anthropic.claude-sonnet-4-6 most accurate
# Optional fallback (OpenAI-compatible)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Leave empty to call the mocks in-process; set to http://127.0.0.1:8000 to use the FastAPI server
MOCK_BASE_URL=
